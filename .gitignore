# ---- Data (download from Kaggle; never commit) ----
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/*/.gitkeep

# ---- Models (stored on Hugging Face Hub) ----
models/checkpoints/*
models/final/*
!models/*/.gitkeep
*.pkl
*.joblib
*.pt
*.bin
*.safetensors

# ---- Large or generated results ----
results/predictions/*
!results/predictions/.gitkeep

# ---- Logs ----
logs/*
!logs/.gitkeep

# ---- Secrets ----
.env
*.key

# ---- Python / Jupyter ----
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/

# ---- OS / editors ----
.DS_Store
Thumbs.db
.vscode/
.idea/
